# ─────────────────────────────────────────────────────────────
# sylvanusfannah.com — environment variables
# Copy to .env.local for local development. Add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Every key is optional for the build; features switch on as you add them.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://sylvanusfannah.com

# ── Neon Postgres (stores quote requests) ────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Resend (email alert for every new quote request) ────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Until your domain is verified in Resend, this MUST be your Resend account email
QUOTE_NOTIFICATION_EMAIL=you@example.com
# Until your domain is verified, keep onboarding@resend.dev
RESEND_FROM_EMAIL=Sylvanus Fannah Website <onboarding@resend.dev>

# ── Cloudflare Turnstile (spam protection) ───────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Auth.js (admin area, GitHub login) ───────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GITHUB_ID=Ov23lixxxxxxxxxxxxxx
AUTH_GITHUB_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only this GitHub username can sign in to /admin
ADMIN_GITHUB_USERNAME=your-github-username
# Required on Vercel only if you use a custom domain behind a proxy; Vercel sets it automatically otherwise
# AUTH_TRUST_HOST=true

# ── Rate limiting (optional; random string used to hash visitor IPs) ──
RATE_LIMIT_SALT=replace-with-another-random-string
